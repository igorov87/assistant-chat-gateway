{
  "openapi": "3.0.3",
  "info": {
    "title": "Assistant Gateway",
    "description": "API Gateway para la seguridad de los asistentes de IA",
    "version": "1.0.0",
    "contact": {
      "name": "Interseguro GENAI Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Servidor de desarrollo local"
    }
  ],
  "tags": [
    {
      "name": "Agent",
      "description": "Endpoints relacionados con el agente AI y generación de respuestas"
    }
  ],
  "paths": {
    "/v1/llm/stream/question": {
      "post": {
        "tags": ["Agent"],
        "summary": "Obtener respuesta en streaming del agente AI",
        "description": "Envía una pregunta al agente AI y obtiene una respuesta en tiempo real mediante streaming",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream de respuesta exitoso",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Stream de eventos del servidor con datos de respuesta"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - Token inválido o faltante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/llm/history/{idUsuario}": {
      "get": {
        "tags": ["Agent"],
        "summary": "Obtener historial de conversaciones de un usuario",
        "description": "Retorna el historial completo de conversaciones del usuario especificado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "description": "Identificador único del usuario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historial obtenido exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - Token inválido o faltante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Historial no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de autenticación Firebase"
      }
    },
    "schemas": {
      "QuestionInput": {
        "type": "object",
        "required": ["user", "assistant", "question", "assistantName"],
        "properties": {
          "user": {
            "type": "string",
            "description": "ID del usuario que hace la pregunta"
          },
          "assistant": {
            "type": "string",
            "description": "ID del asistente AI"
          },
          "question": {
            "type": "string",
            "description": "Pregunta a realizar al agente AI"
          },
          "assistantName": {
            "type": "string",
            "description": "Nombre del asistente AI"
          },
          "conversationId": {
            "type": "string",
            "nullable": true,
            "description": "ID de la conversación (opcional)"
          },
          "history": {
            "type": "string",
            "default": "",
            "description": "Historial de conversación"
          },
          "memory": {
            "type": "boolean",
            "default": true,
            "description": "Usar memoria para la conversación"
          },
          "networkUser": {
            "type": "string",
            "default": "",
            "description": "Usuario de red"
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ID del usuario"
          },
          "conversations": {
            "type": "array",
            "description": "Lista de conversaciones del usuario",
            "items": {
              "type": "object",
              "description": "Datos de la conversación"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ERROR"]
          },
          "message": {
            "type": "string",
            "description": "Descripción del error"
          }
        }
      }
    }
  }
}
