    "firebase-admin": "^12.6.0",
    "google-auth-library": "^9.14.1",
    "hapi-k8s-health": "^1.1.1",
    "joi": "^17.13.3",
    "moment": "^2.29.4",
    "pino": "^8.14.1",
    "pino-caller": "^3.4.0",
    "ts-mapper": "^1.2.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@hapi/lab": "^25.1.2",
    "@types/hapi": "^18.0.8",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "jest": "^29.5.0",
    "jest-html-reporter": "3.10.1",
    "nodemon": "^3.1.9",
    "reflect-metadata": "^0.1.13",
    "supertest": "^6.3.3",
